NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase REST (server-side)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Postgres migrations — use ONE of:
# Full URI from Dashboard → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# Or database password only (direct host):
SUPABASE_DB_PASSWORD="your-database-password"
SUPABASE_DB_REGION=ap-southeast-1

DB_PROVIDER=supabase

JWT_SECRET=generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
